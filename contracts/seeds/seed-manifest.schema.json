{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcb-cdso.local/schemas/seed-manifest.schema.json",
  "title": "PCB-CDSO Seed Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "datasetVersion",
    "verificationStatus",
    "source",
    "owner",
    "governance",
    "checksum",
    "dependencies",
    "verificationEvidence",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "datasetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "verificationStatus": {
      "enum": ["UNVERIFIED", "SOFTWARE_VERIFIED", "EXPERT_VERIFIED"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference", "collectedAt"],
      "properties": {
        "type": {
          "enum": ["RESEARCH", "STANDARD", "EXPERT", "SYNTHETIC", "PROVIDER"]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "softwareVerifier", "expertApprover"],
      "properties": {
        "producer": {"type": "string", "minLength": 1},
        "softwareVerifier": {"type": "string", "minLength": 1},
        "expertApprover": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["datasetId", "datasetVersion"],
        "properties": {
          "datasetId": {
            "type": "string"
          },
          "datasetVersion": {
            "type": "string"
          }
        }
      }
    },
    "verificationEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "verifiedBy", "verifiedAt", "method", "signedRecordPath"],
        "properties": {
          "status": {"enum": ["SOFTWARE_VERIFIED", "EXPERT_VERIFIED"]},
          "verifiedBy": {"type": "string", "minLength": 1},
          "verifiedAt": {"type": "string", "format": "date-time"},
          "method": {"type": "string", "minLength": 1},
          "signedRecordPath": {"type": "string", "minLength": 1}
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stableId", "labels", "payload"],
        "properties": {
          "stableId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,127}$"
          },
          "labels": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zhCN", "enUS"],
            "properties": {
              "zhCN": {
                "type": "string",
                "minLength": 1
              },
              "enUS": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "payload": {
            "type": "object"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verificationStatus": {"const": "EXPERT_VERIFIED"}
        }
      },
      "then": {
        "properties": {
          "verificationEvidence": {
            "contains": {
              "properties": {"status": {"const": "EXPERT_VERIFIED"}},
              "required": ["status"]
            }
          }
        }
      }
    }
  ]
}
