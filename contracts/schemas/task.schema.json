{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcb-cdso.local/schemas/task.schema.json",
  "title": "PCB-CDSO Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "status", "progress", "stage", "processed", "total", "error", "retryable"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["DISPATCH_PENDING", "QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED", "STALE"]},
    "progress": {"type": "integer", "minimum": 0, "maximum": 100},
    "stage": {"type": "string"},
    "processed": {"type": "integer", "minimum": 0},
    "total": {"type": "integer", "minimum": 0},
    "error": {"oneOf": [{"$ref": "error.schema.json"}, {"type": "null"}]},
    "retryable": {"type": "boolean"}
  }
}
